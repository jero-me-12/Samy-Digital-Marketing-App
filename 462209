    const getAllRects = () => document.querySelectorAll('.rect');
    let autoSlideTimer, userInteracting = false;
    
    function updateActive() {
      const c = wrapper.scrollLeft + wrapper.offsetWidth / 2;
      let closest = null,
        md = Infinity;
      getAllRects().forEach(rect => {
        let rc = rect.offsetLeft + rect.offsetWidth / 2;
        let dist = Math.abs(c - rc);
        if (dist < md) {
          md = dist;
          closest = rect
        }
      });
      getAllRects().forEach(r => r.classList.remove('active'));
      if (closest) {
        closest.classList.add('active');
        dots.forEach((dot, i) => dot.classList.toggle('active', heroImages[i] === closest.dataset.val))
      }
    }
    
    function scrollToReal(el) { wrapper.scrollTo({ left: el.offsetLeft - wrapper.offsetWidth / 2 + el.offsetWidth / 2, behavior: 'smooth' }) }
    
    function scrollToIndex(i) {
      const rects = getAllRects();
      scrollToReal(rects[Math.floor(rects.length / 2) - 2 + i])
    }
    
    function nextSlide() {
      const c = wrapper.scrollLeft + wrapper.offsetWidth / 2;
      let idx = -1,
        md = Infinity;
      getAllRects().forEach((rect, i) => {
        let rc = rect.offsetLeft + rect.offsetWidth / 2;
        let dist = rc - c;
        if (dist > 10 && dist < md) {
          md = dist;
          idx = i
        }
      });
      if (idx !== -1) scrollToReal(getAllRects()[idx])
    }
    wrapper.addEventListener('scroll', () => {
      updateActive();
