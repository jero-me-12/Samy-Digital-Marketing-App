  <script>
    const API_BASE = 'http://127.0.0.1:5000';
    document.getElementById('year').textContent = new Date().getFullYear();
    
    function escapeHtml(s) { return String(s || '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } [c])) }
    
    function resolveImageUrl(u) { if (!u) return ''; return u.startsWith('http') ? u : API_BASE + u }
    
    function formatPrice(p) { return 'UGX ' + Number(p || 0).toLocaleString('en-UG') }
    
    function getToken() { return localStorage.getItem('token') }
    
    function getUser() { try { return JSON.parse(localStorage.getItem('user')) } catch (e) { return null } }
    
    function setAuth(t, u) {
      localStorage.setItem('token', t);
      localStorage.setItem('user', JSON.stringify(u))
    }
    
    function clearAuth() {
      localStorage.removeItem('token');
      localStorage.removeItem('user')
    }
    async function apiFetch(path, opt) {
      opt = opt || {};
      opt.headers = opt.headers || {};
      if (!(opt.body instanceof FormData)) opt.headers['Content-Type'] = 'application/json';
      const tok = getToken();
      if (tok) opt.headers['Authorization'] = 'Bearer ' + tok;
