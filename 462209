      loader.style.borderTop = '10px solid var(--primary-dark)';
      loader.style.borderBottom = '10px solid var(--primary-dark)';
      loader.style.borderRadius = '100px';
      loader.style.height = '70px';
      loader.style.width = '70px';
      loader.style.animation = 'rotate 2s infinite';
      
      // Add animation
      const style = document.createElement('style');
      style.textContent = `@keyframes rotate{from{transform:rotate(350deg)} to{transform:rotate(0deg)}}`;
      
      const text = document.createElement('p');
      text.textContent = 'Loading...';
      
      w.append(loader, text, style);
      // end of the loader 
      
      showPage('item-page');
      try {
        const item = await apiFetch('/api/items/' + id);
        const imgUrl = item.image_url ? resolveImageUrl(item.image_url) : '';
        const metaLine = [item.category, item.location].filter(Boolean).map(escapeHtml).join(' • ');
        w.innerHTML = `${item.image_url?`<div class="insta-img-wrap" style="border-radius:14px" onclick="openLightbox('${imgUrl}')"><img src="${imgUrl}"><span class="tap-hint">${ICON_EXPAND} View full</span></div>`:''}<h2>${escapeHtml(item.title)}</h2><p style="color:#1d4ed8;font-weight:700;font-size:1.3rem">${formatPrice(item.price)}</p><p style="color:#5b6270">${metaLine} • Seller: ${item.seller?escapeHtml(item.seller.name):'Unknown'}</p><p style="margin-top:14px">${escapeHtml(item.description)}</p>${item.contact?`<p style="margin-top:8px;color:#5b6270"><b>Contact:</b> ${escapeHtml(item.contact)}</p>`:''}<div style="display:flex;gap:12px;margin-top:14px"><button class="btn btn-primary" style="width:auto;display:flex;align-items:center;gap:8px" onclick="toggleLike(${item.id},this)">${ICON_THUMB.replace('<svg ','<svg style="width:18px;height:18px;stroke:#fff" ')} ${item.likes_count||0} Likes</button><button class="btn" style="background:#f0f0f0;display:flex;align-items:center;gap:8px" onclick="toggleSave(${item.id},this)">${ICON_SAVE.replace('<svg ','<svg style="width:18px;height:18px" ')} Save</button></div>`;
        loadComments(id)
      } catch (e) { w.innerHTML = `<div style='height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:24px; color:#16181d;'>
    <h1 style='font-size:1.2rem; margin-bottom:8px;'>You're offline</h1>
    <p style='color:#5b6270; margin-bottom:20px; '>Check your internet connection and try again.</p>
    <button onclick="location.reload()"style = ' padding:12px 24px; border-radius:999px; border:none; background:var(--primary-dark); color:var(--bg); font-size:0.95rem; ' >Retry</button>
  </div>` }
    }
    async function loadComments(id) {
      const w = document.getElementById('comments-wrap');
      w.innerHTML = '<p>Loading comments...</p>';
      try {
        const comments = await apiFetch(`/api/items/${id}/comments`);
        w.innerHTML = `<h3>Comments (${comments.length})</h3>${comments.map(c=>`<div class="comment-item"><b>${escapeHtml(c.user_name||'User')}</b> ${escapeHtml(c.text)}</div>`).join('')||'<p style="color:#5b6270">No comments yet.</p>'}<div class="comment-box"><input id="comment-input" placeholder="Add a comment..."><button class="btn btn-primary" onclick="postComment()">Post</button></div>`
      } catch (e) { w.innerHTML = '' }
    }
    async function postComment() {
      const inp = document.getElementById('comment-input');
      if (!inp.value.trim()) return;
      if (!getToken()) { showPage('sign_up-page'); return }
      try {
        await apiFetch(`/api/items/${activeItemId}/comments`, { method: 'POST', body: JSON.stringify({ text: inp.value.trim() }) });
        inp.value = '';
        loadComments(activeItemId);
        loadItems()
      } catch (e) { alert(e.message) }
    }
    document.getElementById('contact-seller-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      const s = document.getElementById('contact-seller-status');
      if (!activeItemId) return;
      try {
        await apiFetch(`/api/items/${activeItemId}/contact`, { method: 'POST', body: JSON.stringify({ name: document.getElementById('contact-name').value.trim(), email: document.getElementById('contact-email').value.trim(), message: document.getElementById('contact-message').value.trim() }) });
        s.style.color = '#1d7a3c';
        s.textContent = 'Message sent!';
        this.reset()
      } catch (err) {
        s.style.color = '#c0392b';
        s.textContent = err.message
      }
    });
    
    // PROFILE
    async function loadProfile() {
      const w = document.getElementById('profile-content');
      const user = getUser();
      if (!user || !getToken()) { w.innerHTML = `<p>You're not logged in.</p><button class="btn btn-primary" onclick="showPage('sign_up-page')" style="margin-top:12px">Login / Sign Up</button>`; return }
      
      // beginning of the loader
      w.innerHTML = '';
      w.style.display = 'flex';
      w.style.height = 'auto';
      w.style.flexDirection = 'column';
      w.style.alignItems = 'center';
      w.style.justifyContent = 'center';
      w.style.background = 'white';
      
      // Loader div
      const loader = document.createElement('div');
      loader.style.border = '10px solid white';
      loader.style.borderTop = '10px solid var(--primary-dark)';
      loader.style.borderBottom = '10px solid var(--primary-dark)';
      loader.style.borderRadius = '100px';
      loader.style.height = '70px';
      loader.style.width = '70px';
      loader.style.animation = 'rotate 2s infinite';
      
      // Add animation
      const style = document.createElement('style');
      style.textContent = `@keyframes rotate{from{transform:rotate(350deg)} to{transform:rotate(0deg)}}`;
      
      const text = document.createElement('p');
      text.textContent = 'Loading...';
      
      w.append(loader, text, style);
      //end of the loader
      
      
      try {
        const d = await apiFetch('/api/me');
        const itemsHtml = d.items.length ? d.items.map(it => `<div class="my-item-row"><div><strong>${escapeHtml(it.title)}</strong><br><span style="color:#5b6270">${formatPrice(it.price)} • ${ICON_THUMB.replace('<svg ','<svg style="width:14px;height:14px;vertical-align:-2px" ')} ${it.likes_count||0} • ${ICON_COMMENT.replace('<svg ','<svg style="width:14px;height:14px;vertical-align:-2px" ')} ${it.comments_count||0}</span></div><div style="display:flex;gap:8px;flex-shrink:0"><button class="btn-edit" onclick="editMyItem(${it.id})">Edit</button><button class="btn-danger" onclick="deleteMyItem(${it.id})">Delete</button></div></div>`).join('') : '<p style="color:#5b6270">You haven\'t posted anything yet.</p>';
        const savedHtml = d.saved && d.saved.length ? d.saved.map(it => `<div class="my-item-row" onclick="openItem(${it.id})"><div><strong>${escapeHtml(it.title)}</strong><br>${formatPrice(it.price)}</div><span>${ICON_SAVE.replace('<svg ','<svg style="width:16px;height:16px" ')}</span></div>`).join('') : '<p style="color:#5b6270">No saved items.</p>';
        const msgsHtml = d.messages && d.messages.length ? d.messages.map(m => `<div style="border:1px solid #ececf1;border-radius:10px;padding:12px;margin-bottom:8px"><b>${escapeHtml(m.sender_name)}</b> (${escapeHtml(m.sender_email)})<br>${escapeHtml(m.message)}<br><small style="color:#5b6270">Item #${m.item_id}</small></div>`).join('') : '<p style="color:#5b6270">No messages yet.</p>';
        w.innerHTML = `<div style="display:flex;align-items:center;gap:14px"><div class="insta-avatar" style="width:56px;height:56px;font-size:22px">${avatarHtml(d.user.name,d.user.avatar_url)}</div><div><h2 style="margin:0">${escapeHtml(d.user.name)}</h2><p style="color:#5b6270;margin:4px 0">${escapeHtml(d.user.email)}</p><p style="margin:0"><b>${d.items.length}</b> posts • <b>${d.total_likes||0}</b> likes</p></div></div><h3 style="margin-top:24px">My Posted Items</h3>${itemsHtml}<h3 style="margin-top:24px">Saved Items</h3>${savedHtml}<h3 style="margin-top:24px">Messages From Buyers</h3>${msgsHtml}<div style="margin-top:20px"><button class="btn btn-outline" style="width:100%" onclick="showPage('settings-page')">⚙ Account &amp; Settings</button></div>`
      } catch (err) { w.innerHTML = `<div style='height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:24px; color:#16181d;'>
    <h1 style='font-size:1.2rem; margin-bottom:8px;'>You're offline</h1>
    <p style='color:#5b6270; margin-bottom:20px; '>Check your internet connection and try again.</p>
    <button onclick="location.reload()"style = ' padding:12px 24px; border-radius:999px; border:none; background:var(--primary-dark); color:var(--bg); font-size:0.95rem; ' >Retry</button>
  </div>`; }
    }
    
    
    async function deleteMyItem(id) {
      if (!confirm('Delete this item?')) return;
      try {
        await apiFetch('/api/items/' + id, { method: 'DELETE' });
        loadProfile()
      } catch (e) { alert(e.message) }
    }
    
    // EDIT ITEM
    let editingItemId = null;
    async function editMyItem(id) {
      try {
        const item = await apiFetch('/api/items/' + id);
        editingItemId = id;
        document.getElementById('edit-item-title').value = item.title || '';
        document.getElementById('edit-item-price').value = item.price || '';
        document.getElementById('edit-item-category').value = item.category || 'General';
        document.getElementById('edit-item-description').value = item.description || '';
        document.getElementById('edit-item-location').value = item.location || '';
        document.getElementById('edit-item-contact').value = item.contact || '';
        document.getElementById('edit-item-status').textContent = '';
        document.getElementById('editItemModal').classList.add('open')
      } catch (e) { alert(e.message) }
    }
    
    function closeEditItemModal(e) {
      document.getElementById('editItemModal').classList.remove('open');
      editingItemId = null
    }
    document.getElementById('edit-item-form').addEventListener('submit', async e => {
      e.preventDefault();
      if (!editingItemId) return;
      const s = document.getElementById('edit-item-status');
      const btn = document.getElementById('edit-item-submit-btn');
      btn.disabled = true;
      s.style.color = '';
      s.textContent = '';
      try {
        await apiFetch('/api/items/' + editingItemId, {
          method: 'PUT',
          body: JSON.stringify({
            title: document.getElementById('edit-item-title').value.trim(),
            price: document.getElementById('edit-item-price').value,
            category: document.getElementById('edit-item-category').value,
            description: document.getElementById('edit-item-description').value.trim(),
            location: document.getElementById('edit-item-location').value.trim(),
            contact: document.getElementById('edit-item-contact').value.trim()
          })
        });
        closeEditItemModal();
        loadProfile();
        showToast('Item updated')
      } catch (err) {
        s.style.color = '#c0392b';
        s.textContent = err.message
      } finally { btn.disabled = false }
    });
    
    function logout() {
      clearAuth();
      loadProfile();
      showPage('home-page')
    }
    
    // SETTINGS
    function loadSettings() {
      const s = JSON.parse(localStorage.getItem('appSettings') || '{}');
      document.getElementById('setting-notif').checked = s.notif !== false;
      document.getElementById('setting-email').checked = !!s.email;
      document.getElementById('setting-private').checked = !!s.private
    }
    
    
    function saveSetting(key, val) {
      const s = JSON.parse(localStorage.getItem('appSettings') || '{}');
      s[key] = val;
      localStorage.setItem('appSettings', JSON.stringify(s));
      showToast('Settings saved')
    }
    async function deleteAccount() {
      if (!getToken()) { showPage('sign_up-page'); return }
      if (!confirm('This will permanently delete your account and everything you posted. Continue?')) return;
      if (!confirm('Are you absolutely sure? This cannot be undone.')) return;
      try {
        await apiFetch('/api/me', { method: 'DELETE' });
        clearAuth();
        showToast('Account deleted');
        showPage('home-page')
      } catch (e) { alert(e.message) }
    }
    
    // AGENT
    document.getElementById('agent-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      const s = document.getElementById('agent-status');
      try {
        s.style.color = '#5b6270';
        s.textContent = 'Submitting...';
        await apiFetch('/api/agent-apply', { method: 'POST', body: JSON.stringify({ name: document.getElementById('agent-name').value.trim(), phone: document.getElementById('agent-phone').value.trim(), email: document.getElementById('agent-email').value.trim(), area: document.getElementById('agent-area').value.trim(), message: document.getElementById('agent-message').value.trim() }) });
        s.style.color = '#1d7a3c';
        s.textContent = 'Application submitted! We will contact you soon.';
        this.reset()
      } catch (err) {
        s.style.color = '#c0392b';
        s.textContent = err.message
      }
    });
  </script>
  
  
  
</body>

</html>