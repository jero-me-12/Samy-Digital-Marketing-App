<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
  <title>Samy - Marketplace</title>
  <style>
    :root {
      --primary: #1d4ed8;
      --primary-dark: #1538a6;
      --accent: #f59e0b;
      --bg: #fff;
      --bg-alt: #f5f7fb;
      --text: #16181d;
      --text-muted: #5b6270;
      --radius: 14px;
      --red:#FF4404;
    }
    
    * {
      box-sizing: border-box
    }
    
    html,
    body {
      margin: 0;
      padding: 0;
      font-family: -apple-system, Roboto, "Segoe UI", Helvetica, Arial, sans-serif;
      color: var(--text);
      background: var(--bg);
      -webkit-tap-highlight-color: transparent
    }
    
    img {
      max-width: 100%;
      display: block
    }
    
    .container {
      max-width: 1080px;
      margin: 0 auto;
      padding: 0 20px
    }
    
    .hero {
      background: linear-gradient(135deg, var(--primary), var(--primary-dark));
      color: #fff;
      padding: 64px 0 56px;
      text-align: center
    }
    
    .hero h1 {
      font-size: clamp(1.8rem, 5vw, 2.6rem);
      margin: 0 0 14px
    }
    
    .hero p {
      font-size: 1.05rem;
      opacity: .92;
      max-width: 560px;
      margin: 0 auto 28px
    }
    
    .btn {
      display: inline-block;
      padding: 13px 26px;
      border-radius: 999px;
      font-weight: 600;
      text-decoration: none;
      font-size: .95rem;
      border: none;
      cursor: pointer
    }
    
    .btn-accent {
      background: var(--accent);
      color: #1a1a1a
    }
    
    .btn-outline {
      background: transparent;
      color: #fff;
      border: 2px solid rgba(255, 255, 255, .7);
      margin-left: 10px
    }
    
    section {
      padding: 56px 0
    }
    
    .section-alt {
      background: var(--bg-alt)
    }
    
    .section-title {
      text-align: center;
      font-size: 1.6rem;
      margin-bottom: 8px
    }
    
    .section-sub {
      text-align: center;
      color: var(--text-muted);
      max-width: 520px;
      margin: 0 auto 36px
    }
    
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 22px
    }
    
    .card {
      background: var(--bg);
      border: 1px solid #ececf1;
      border-radius: var(--radius);
      padding: 24px
    }
    
    .card .icon {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      background: var(--primary);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      margin-bottom: 14px
    }
    
    .card h3 {
      margin: 0 0 8px;
      font-size: 1.05rem
    }
    
    .card p {
      margin: 0;
      color: var(--text-muted);
      font-size: .92rem
    }
    
    .testimonial {
      background: var(--bg);
      border: 1px solid #ececf1;
      border-radius: var(--radius);
      padding: 22px
    }
    
    .testimonial p {
      font-style: italic
    }
    
    .testimonial .author {
      margin-top: 12px;
      font-weight: 600;
      font-size: .9rem;
      color: var(--text-muted)
    }
    
    .form-wrap {
      max-width: 520px;
      margin: 0 auto
    }
    
    .field {
      margin-bottom: 16px
    }
    
    .field label {
      display: block;
      margin-bottom: 6px;
      font-size: .9rem;
      font-weight: 600
    }
    
    .field input,
    .field textarea,
    .field select {
      width: 100%;
      padding: 12px 14px;
      border-radius: 10px;
      border: 1px solid #d7dae1;
      font-size: .95rem;
      font-family: inherit;
      background: var(--bg)
    }
    
    .field textarea {
      min-height: 110px;
      resize: vertical
    }
    
    
    
    .btn-primary {
      background: var(--primary);
      color: #fff;
      width: 100%;
      padding: 14px;
      font-size: 1rem
    }
    
    .form-status {
      margin-top: 12px;
      font-size: .9rem;
      text-align: center;
      min-height: 1.2em
    }
    
    .auth-wrap {
      max-width: 420px;
      margin: 0 auto
    }
    
    .auth-tabs {
      display: flex;
      gap: 10px;
      margin-bottom: 20px
    }
    
    .auth-tab {
      flex: 1;
      padding: 12px;
      border-radius: 10px;
      border: 1px solid #d7dae1;
      background: var(--bg);
      cursor: pointer;
      font-weight: 600
    }
    
    .auth-tab.active {
      background: var(--primary);
      color: #fff;
      border-color: var(--primary)
    }
    
    .search-bar {
      display: flex;
      gap: 10px;
      margin-bottom: 20px;
      flex-wrap: wrap
    }
    
    .search-bar input,
    .search-bar select {
      padding: 12px 14px;
      border-radius: 10px;
      border: 1px solid #d7dae1;
      font-size: .95rem;
      font-family: inherit
    }
    
    .search-bar input {
      flex: 1;
      min-width: 180px
    }
    
    .my-item-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border: 1px solid #ececf1;
      border-radius: 10px;
      padding: 14px;
      margin-bottom: 10px
    }
    
    .btn-danger {
      background: #dc2626;
      color: #fff;
      padding: 8px 16px;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      font-size: .85rem
    }
    
    .btn-edit {
      background: #1d4ed8;
      color: #fff;
      padding: 8px 16px;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      font-size: .85rem
    }
    
    footer {
      background: #14161b;
      color: #c9cdd6;
      padding: 32px 0;
      text-align: center;
      font-size: .85rem
    }
    
    footer a {
      color: #fff
    }
    
    .card reveal {
      opacity: 0;
      transform: translateY(16px);
      transition: .5s
    }
    
    .card reveal .visible {
      opacity: 1;
      transform: translateY(0)
    }
    
    .card reveal {
      transform: translateY(-8px);
      box-shadow: 0 10px 20px rgba(56, 189, 248, 0.2);
    }
    
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: transparent;
      backdrop-filter: blur(9px);
      padding: 5px 20px;
      box-shadow: 0 2px 5px rgba(0, 0, 0, .1);
      position: sticky;
      top: 0;
      z-index: 9999
    }
    
    .logo {
      display: flex;
      align-items: center;
      cursor: pointer
    }
    
    .logo header-icon {}
    
    
    
    .dropdown {
      position: relative
    }
    
    .dots-btn {
      background: none;
      border: none;
      cursor: pointer;
      font-size: 22px;
      padding: 5px 10px
    }
    
    .dropdown-content {
      display: none;
      position: absolute;
      right: 0;
      top: 35px;
      background: var(--bg);
      min-width: 180px;
      box-shadow: 0 4px 12px rgba(0, 0, 0, .15);
      border-radius: 8px;
      overflow: hidden;
      z-index: 100
    }
    
    .dropdown-content a {
      display: block;
      padding: 12px 16px;
      text-decoration: none;
      color: var(--accent);
      font-size: 14px
    }
    
    .dropdown-content a:hover {
      background: var(--primary-dark);
      color: var(--bg);
      
      
    }
    
    .dropdown.active .dropdown-content {
      display: block
    }
    
    .wrapper {
      position: relative;
      width: 100%;
      height: 35vh;
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
      padding: 50px 0 20px;
      
    }
    
    .wrapper::-webkit-scrollbar {
      display: block
    }
    
    .track {
      display: flex;
      gap: 20px;
      padding: 0 50vw;
      align-items: center;
      width: max-content
    }
    
    .rect {
      min-width: 200px;
      width: 200px;
      height: 120px;
      background: #1c2333;
      border-radius: 14px;
      /*border: 2px solid #2a3754;*/
      display: flex;
      align-items: center;
      justify-content: center;
      color: #5a6a8a;
      font-weight: bold;
      font-size: 22px;
      transition: .35s;
      transform: scale(.85);
      opacity: .6;
      cursor: pointer;
      overflow: hidden
    }
    
    .rect.active {
      width: 260px;
      min-width: 260px;
      height: 160px;
      background: #26324d;
      border-color: none;
      color: #fff;
      transform: scale(1.15);
      opacity: 1;
      box-shadow: 0 15px 40px var(--text)
    }
    
    .rect img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      pointer-events: none
    }
    
    .dots {
      position: absolute;
      left: 50%;
      bottom: 12px;
      transform: translateX(-50%);
      display: flex;
      gap: 10px;
      align-items: center;
      z-index: 999;
    }
    
    .dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--bg);
      transition: .9s;
      cursor: pointer
    }
    
    .dot.active {
      background: var(--accent);
      width: 90px;
      border-radius: 10px
    }
    
    .page {
      display: none;
      width: 100%;
      max-width: 100%;
      overflow-x: hidden;
      padding-bottom: 76px
    }
    
    
    
    .page.active-page {
      display: block;
      animation: pageFadeIn .28s ease
    }
    
    @keyframes pageFadeIn {
      from {
        opacity: 0;
        transform: translateY(10px)
      }
      
      to {
        opacity: 1;
        transform: translateY(0)
      }
    }
    
    
    
    
    
    
    
    .content-box {
      transition: transform .4s
    }
    
    .content-box:active {
      transform: scale(.98)
    }
    
    .ad-slider {
      position: relative;
      width: 100%;
      height: 260px;
      overflow: hidden;
      background: #000;
      border-radius: 0
    }
    
    .ad-slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity .6s;
      display: flex;
      align-items: flex-end;
      color: #fff;
      background-size: cover;
      background-position: center
    }
    
    .ad-slide.active {
      opacity: 1
    }
    
    .ad-slide::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(0, 0, 0, .75), rgba(0, 0, 0, .05))
    }
    
    .ad-content {
      position: relative;
      padding: 20px;
      width: 100%
    }
    
    .ad-content h3 {
      margin: 6px 0 4px;
      font-size: 1.4rem
    }
    
    .ad-content p {
      margin: 0 0 12px;
      opacity: .92;
      font-size: .9rem
    }
    
    .ad-tag {
      background: var(--accent);
      color: #000;
      font-size: .7rem;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 999px
    }
    
    .ad-content .btn {
      padding: 10px 18px;
      font-size: .85rem
    }
    
    .ad-dots {
      position: absolute;
      bottom: 10px;
      right: 16px;
      display: flex;
      gap: 8px;
      z-index: 2
    }
    
    .ad-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: rgba(255, 255, 255, .5);
      cursor: pointer
    }
    
    .ad-dot.active {
      background: #fff
    }
    
    /* INSTAGRAM FEED - WIDTH FIX */
    #market-page .container {
      max-width: 500px;
      width: 100%;
      padding: 0 12px;
      margin: 0 auto
    }
    
    #item-grid {
      display: flex;
      flex-direction: column;
      gap: 18px;
      width: 100%
    }
    
    .insta-card {
      background: #fff;
      border: 1px solid #dbdbdb;
      border-radius: 12px;
      overflow: hidden;
      width: 100%;
      cursor: pointer
    }
    
    .insta-header {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 14px
    }
    
    .insta-avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: linear-gradient(45deg, #f59e0b, #ec4899, #8b5cf6);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 14px;
      flex-shrink: 0;
      overflow: hidden
    }
    
    .insta-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 50%
    }
    
    .insta-name {
      font-weight: 600;
      font-size: .9rem
    }
    
    .insta-cat {
      font-size: .75rem;
      color: #737373
    }
    
    .insta-img-wrap {
      width: 100%;
      aspect-ratio: 1/1;
      background: #f0f0f0;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #999;
      position: relative
    }
    
    .insta-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover
    }
    
    .insta-img-wrap .tap-hint {
      position: absolute;
      bottom: 8px;
      right: 8px;
      background: rgba(0, 0, 0, .55);
      color: #fff;
      font-size: .68rem;
      padding: 4px 8px;
      border-radius: 999px;
      display: flex;
      align-items: center;
      gap: 4px;
      pointer-events: none
    }
    
    .insta-actions {
      display: flex;
      gap: 18px;
      padding: 10px 14px 0;
      align-items: center
    }
    
    .insta-actions span {
      cursor: pointer;
      user-select: none;
      display: inline-flex;
      align-items: center
    }
    
    .insta-actions svg {
      width: 24px;
      height: 24px;
      stroke: #16181d;
      fill: none;
      stroke-width: 1.8
    }
    
    .insta-actions span.liked svg {
      fill: #1d4ed8;
      stroke: #1d4ed8
    }
    
    .insta-actions span.saved svg {
      fill: #1d4ed8;
      stroke: #1d4ed8
    }
    
    .insta-body {
      padding: 8px 14px 14px
    }
    
    .insta-price {
      color: #1d4ed8;
      font-weight: 800;
      font-size: 1.05rem;
      margin: 0 0 4px
    }
    
    .insta-title {
      font-weight: 600;
      margin: 0 0 4px;
      font-size: .95rem
    }
    
    .insta-desc {
      color: #5b6270;
      font-size: .88rem;
      margin: 0;
      line-height: 1.4
    }
    
    .details-link {
      display: inline-block;
      margin-top: 6px;
      color: #1d4ed8;
      font-weight: 600;
      font-size: .85rem;
      cursor: pointer
    }
    
    .insta-likes {
      font-weight: 600;
      font-size: .85rem;
      margin: 0 0 4px
    }
    
    /* ICONS */
    .icon-svg {
      width: 26px;
      height: 26px;
      display: block
    }
    
    .header-icon {
      width: 30px;
      height: 30px;
      display: flex;
      align-items: center;
      justify-content: center
    }
    
    .header-icon svg {
      width: 24px;
      height: 24px;
      stroke: var(--accent);
      fill: none;
      stroke-width: 1.8
    }
    
    .header-icon.market-icon svg {
      stroke: var(--accent);
    }
    
    /* STORIES */
    .stories {
      display: flex;
      gap: 16px;
      overflow-x: auto;
      padding: 14px 4px 18px;
      scrollbar-width: none
    }
    
    .stories::-webkit-scrollbar {
      display: none
    }
    
    .story {
      flex-shrink: 0;
      text-align: center;
      width: 68px;
      cursor: pointer
    }
    
    .story-circle {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      padding: 3px;
      background: linear-gradient(45deg, #f59e0b, #ec4899, #8b5cf6);
      position: relative
    }
    
    .story-circle img,
    .story-circle div {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      background: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      object-fit: cover;
      border: 2px solid #fff
    }
    
    .story-badge {
      position: absolute;
      bottom: -2px;
      right: -2px;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: #1d4ed8;
      border: 2px solid #fff;
      display: flex;
      align-items: center;
      justify-content: center
    }
    
    .story-badge svg {
      width: 11px;
      height: 11px;
      stroke: #fff;
      fill: none;
      stroke-width: 2.5
    }
    
    .story span {
      display: block;
      font-size: 11px;
      color: #333;
      margin-top: 4px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis
    }
    
    /* COMMENTS */
    .comment-box {
      display: flex;
      gap: 8px;
      margin-top: 12px;
      align-items: center
    }
    
    .comment-box input {
      flex: 1;
      min-width: 0;
      padding: 10px 12px;
      border-radius: 999px;
      border: 1px solid #d7dae1
    }
    
    .comment-box button {
      flex-shrink: 0;
      white-space: nowrap;
      width: auto;
      padding: 10px 16px
    }
    
    .comment-item {
      font-size: .88rem;
      padding: 6px 0;
      border-bottom: 1px solid #f0f0f0
    }
    
    .chip {
      display: inline-block;
      padding: 6px 12px;
      border-radius: 999px;
      background: #f0f0f0;
      font-size: .8rem;
      cursor: pointer;
      margin: 2px
    }
    
    .chip.active {
      background: #1d4ed8;
      color: #fff
    }
    
    /* LIGHTBOX */
    .lightbox {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, .92);
      z-index: 99999;
      align-items: center;
      justify-content: center;
      padding: 20px
    }
    
    .lightbox.open {
      display: flex
    }
    
    .lightbox img {
      max-width: 100%;
      max-height: 90vh;
      object-fit: contain;
      border-radius: 8px
    }
    
    .lightbox-close {
      position: absolute;
      top: 18px;
      right: 18px;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: rgba(255, 255, 255, .15);
      border: none;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer
    }
    
    .lightbox-close svg {
      width: 20px;
      height: 20px;
      stroke: #fff;
      fill: none;
      stroke-width: 2.2
    }
    
    /* EDIT ITEM MODAL */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, .55);
      z-index: 9998;
      align-items: center;
      justify-content: center;
      padding: 20px
    }
    
    .modal-overlay.open {
      display: flex
    }
    
    .modal-box {
      background: #fff;
      border-radius: 16px;
      padding: 24px;
      max-width: 420px;
      width: 100%;
      max-height: 85vh;
      overflow-y: auto;
      position: relative;
      animation: modalPopIn .22s ease
    }
    
    @keyframes modalPopIn {
      from {
        opacity: 0;
        transform: scale(.96) translateY(6px)
      }
      
      to {
        opacity: 1;
        transform: scale(1) translateY(0)
      }
    }
    
    /* TOAST */
    .toast {
      position: fixed;
      left: 50%;
      bottom: 28px;
      transform: translateX(-50%) translateY(20px);
      background: #16181d;
      color: #fff;
      padding: 12px 20px;
      border-radius: 999px;
      font-size: .88rem;
      opacity: 0;
      pointer-events: none;
      transition: .25s;
      z-index: 999999;
      display: flex;
      align-items: center;
      gap: 8px;
      white-space: nowrap
    }
    
    .toast.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0)
    }
    
    /* PHOTO PICKER */
    .photo-btns {
      display: flex;
      gap: 10px;
      margin-top: 8px
    }
    
    .photo-btn {
      flex: 1;
      padding: 12px;
      border-radius: 10px;
      border: 1px dashed #b9c0cc;
      background: #f8f9fb;
      cursor: pointer;
      font-size: .85rem;
      font-weight: 600;
      color: #1d4ed8;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px
    }
    
    .photo-btn svg {
      width: 22px;
      height: 22px;
      stroke: #1d4ed8;
      fill: none;
      stroke-width: 1.8
    }
    
    /* SETTINGS */
    .settings-group {
      margin: 0 20px 22px;
      border: 1px solid #ececf1;
      border-radius: 12px;
      overflow: hidden
    }
    
    .settings-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px;
      border-bottom: 1px solid #f0f0f0
    }
    
    .settings-row:last-child {
      border-bottom: none
    }
    
    .settings-row .label {
      font-weight: 600;
      font-size: .92rem
    }
    
    .settings-row .sub {
      font-size: .78rem;
      color: var(--text-muted);
      margin-top: 2px
    }
    
    .switch {
      position: relative;
      width: 46px;
      height: 26px;
      flex-shrink: 0
    }
    
    .switch input {
      opacity: 0;
      width: 0;
      height: 0
    }
    
